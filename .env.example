# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- IA : Gemini, gratuit (aistudio.google.com > Get API key) ---
GEMINI_API_KEY=
# Modèles (optionnel) : principal pour l'analyse et les CV, léger pour le tri des emails.
# Si le quota du principal est épuisé, l'app bascule seule sur le léger.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# --- Répartition de la charge (facultatif, gratuit) : chaque clé ajoutée devient un fournisseur de plus ---
# Le tri des emails et les extractions passent d'abord par Groq (puis Mistral, puis Gemini) ;
# l'analyse et les CV d'abord par Gemini (puis Mistral, puis Groq). Si l'un est saturé, le suivant prend le relais.
# Groq : console.groq.com > API Keys
GROQ_API_KEY=
# Mistral : console.mistral.ai > API Keys (plan Experiment). Dans Admin Console > API > Confidentialité, désactive « Autoriser l'utilisation de vos appels API pour entraîner les modèles ».
MISTRAL_API_KEY=
# Ordre des fournisseurs, si tu veux le changer (ex. : groq,mistral,gemini). AI_PROVIDER=gemini impose un seul fournisseur.
# AI_FAST_CHAIN=groq,mistral,gemini,anthropic
# AI_MAIN_CHAIN=gemini,mistral,groq,anthropic
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# Modèles Mistral : vois ceux que ton compte peut appeler, et leurs plafonds, dans Admin Console > Limites
# MISTRAL_MODEL=mistral-large-2512
# MISTRAL_FAST_MODEL=ministral-8b-2512

# --- Ou Claude (payant, console.anthropic.com) : en dernier recours dans la chaîne, ou seul si aucune autre clé ---
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5

# --- URL publique de l'app (pour les redirections OAuth) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Gmail (Google Cloud Console > OAuth client "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Recherche automatique d'offres (facultatif : sans clé, utilise le favori, les alertes Gmail ou le copier-coller) ---
# Adzuna : clé immédiate et gratuite sur developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble : clé gratuite sur jooble.org/api/about
JOOBLE_API_KEY=

# --- Propriétaire(s) de l'installation : voient Réglages > Installation, sans plafond d'IA ---
# Plusieurs adresses possibles, séparées par des virgules. Vide = tout le monde voit l'installation (usage perso).
OWNER_EMAILS=
# Plafond d'actions IA par personne et par jour. Laisser vide = pas de plafond (les IA gratuites sont partagées :
# quand leurs limites sont atteintes, l'app le dit et on réessaie plus tard). Exemple pour en remettre un : 60 (minimum 5).
AI_DAILY_BUDGET=

# --- Mentions légales (pages /mentions-legales et /confidentialite) ---
PUBLISHER_NAME=
PUBLISHER_EMAIL=

# --- Automatisation quotidienne (Vercel Cron, 7h heure de Paris) ---
# Clé "service_role" de Supabase : secrète, uniquement dans Vercel, jamais côté navigateur
SUPABASE_SERVICE_ROLE_KEY=
# Chaîne aléatoire (ex : openssl rand -hex 32) ; Vercel l'envoie automatiquement au cron
CRON_SECRET=
# Nombre d'offres analysées + CV pré-générés chaque matin (contrôle le coût API)
AUTO_DAILY_LIMIT=3
AUTO_MIN_QUICK_SCORE=55
