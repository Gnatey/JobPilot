{
  "id": "/",
  "name": "JobPilot",
  "short_name": "JobPilot",
  "description": "Ta recherche d'emploi : offres triées, CV sur mesure, suivi des candidatures.",
  "lang": "fr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f2f4f9",
  "theme_color": "#111833",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Analyser une offre", "url": "/offres/nouvelle", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Trier les offres", "url": "/recommandees/tri", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mon suivi", "url": "/suivi", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/partage",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
